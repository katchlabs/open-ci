[Unit]
Description=open-ci GitHub App Credential Rotation Broker
After=network-online.target

[Service]
Type=oneshot
User=open-ci-broker
Group=open-ci
ExecStart=/usr/local/bin/open-ci rotate-credentials --broker-config /etc/open-ci/broker.toml
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/run/open-ci
ReadOnlyPaths=/etc/open-ci
RuntimeDirectory=open-ci
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0027
